{
  "name": "@shooteger/nuxt-stripe",
  "version": "2.2.0",
  "description": "Stripe integration for Nuxt — server-side and client-side composables for payments, Checkout, and Connect",
  "author": {
    "name": "Maurice Putz",
    "url": "https://github.com/Shooteger"
  },
  "homepage": "https://github.com/Shooteger/nuxt-stripe#readme",
  "bugs": {
    "url": "https://github.com/Shooteger/nuxt-stripe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shooteger/nuxt-stripe.git"
  },
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt4",
    "nuxt-module",
    "stripe",
    "stripe-js",
    "payments",
    "vue",
    "vue3",
    "composable",
    "server-side",
    "checkout",
    "payment-intent",
    "stripe-connect",
    "nuxt-modules"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare test/fixtures/basic",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "nuxt-module-build build && nuxi prepare test/fixtures/basic && vitest run",
    "test:watch": "nuxi prepare test/fixtures/basic && vitest watch",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p test/tsconfig.json && nuxi typecheck playground && nuxi typecheck test/fixtures/basic"
  },
  "dependencies": {
    "defu": "^6.1.7"
  },
  "peerDependencies": {
    "nuxt": ">=3.1.0",
    "stripe": ">=17.0.0",
    "@stripe/stripe-js": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@stripe/stripe-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@stripe/stripe-js": "^10.1.0",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "stripe": "^23.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
